{
  "name": "nexus",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS — Inventory, Procurement & Warehouse Intelligence Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "seed": "tsx scripts/seed/index.ts",
    "build": "turbo run build",
    "start": "node apps/api/dist/server.js",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
